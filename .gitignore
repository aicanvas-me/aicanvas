# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.screenshots-tmp/
/public/screenshots/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/

# superpowers brainstorm session files
.superpowers/

# auto-generated (rebuilt on every dev/build)
app/lib/component-codes.generated.ts
/public/r/

# business strategy (private — never pushed to GitHub)
/business-strategy/

# PUFI inspector (local-only dev tool — type "pufi" to toggle)
/public/pufi.js

# KOKO drawing tool (local-only dev tool — type "koko" to toggle)
/public/koko.js

# GSC tooling outputs (audit reports, submission logs)
/scripts/gsc-output/*
!/scripts/gsc-output/.gitkeep

# studio prototype (local-only — see "Studio prototype" memory)
/app/tune/
scripts/sync-output/

# Generated registry JSON (served dynamically from app/r)
/registry-data/*.json
app/lib/component-nav.generated.ts
app/lib/component-meta.generated.ts
app/lib/install-contents.generated.ts
app/lib/andromeda-props.generated.ts
app/lib/standalone-props.generated.ts

# Premium injection — closed-source material that lives ONLY in the private
# aicanvas-premium repo and is pulled in at BUILD time. NEVER tracked here.
# (The check-no-premium-leak.mjs guard is the backstop; these are the first line.)
/components-workspace-premium/
/design-systems-premium/
/components-workspace/zz-premium-*/
/design-systems/zz-premium-*/
/registry-data/_premium.json
app/lib/premium-registry.generated.tsx
app/lib/premium-build-info.generated.ts
app/lib/component-copy.premium.generated.ts

# Free v2 design-system components are ALSO build-time injected (vault-authored,
# never tracked here). The injected files under design-systems/*/components/ are
# excluded via a git info/exclude block managed by scripts/inject-premium.mjs;
# only the generated shim has a stable path to ignore:
app/lib/andromeda-v2.generated.tsx

# Brain paywall teaser (generated by inject-premium — names/counts only; the
# brain CONTENT is bundled into registry-data/_<slug>-brain.json, covered by
# the /registry-data/*.json rule above and unservable via /r)
app/lib/andromeda-brain-teaser.generated.ts

# Private thoughts: planning, strategy, monetization, legal/tax reasoning, notes.
# NEVER commit these — the repo is public. Local only. (See also /business-strategy/.)
/_private/

# unlighthouse scan output (npm run speed)
.unlighthouse/

# Dev-only Studio (aicanvas-studio install). Never ships.
/app/studio/
