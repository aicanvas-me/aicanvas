{
  "name": "aicanvas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "predev": "node scripts/check-deps.mjs",
    "generate": "node scripts/inject-premium.mjs && node scripts/icons-data.mjs && node scripts/site-icons.mjs && node scripts/generate-component-codes.mjs && node scripts/generate-registry.mjs --dev && node scripts/icon-registry.mjs",
    "dev": "npm run generate && next dev -p 3001 --turbopack",
    "dev:webpack": "npm run generate && next dev -p 3001 --webpack",
    "build": "node scripts/inject-premium.mjs && node scripts/icons-data.mjs && node scripts/site-icons.mjs && node scripts/generate-component-codes.mjs && node scripts/generate-registry.mjs && node scripts/icon-registry.mjs && NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "publish-premium": "node scripts/publish-premium.mjs",
    "lint": "eslint",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "pretest": "node scripts/site-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:andromeda": "node scripts/screenshot-andromeda.mjs",
    "speed": "npx unlighthouse@latest --site https://aicanvas.me",
    "validate:registry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-registry-json.ts",
    "gsc:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gsc-audit.ts",
    "gsc:submit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gsc-submit.ts",
    "gsc:keywords": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gsc-keywords.ts",
    "bing:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bing-audit.ts",
    "bing:submit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bing-submit.ts",
    "indexnow": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/indexnow.ts",
    "lint:prompts": "node scripts/lint-prompts.mjs",
    "andromeda:contrast": "node --import ./design-systems/andromeda/_tools/ts-resolve.mjs design-systems/andromeda/_tools/light-contrast.selfcheck.mjs"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.92.0",
    "@modelcontextprotocol/sdk": "~1.32.2",
    "@paddle/paddle-js": "^1.6.6",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.105.4",
    "@types/matter-js": "^0.20.2",
    "@types/three": "^0.187.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^12.38.0",
    "geist": "^1.9.2",
    "lucide-react": "^1.78.0",
    "maplibre-gl": "^5.24.0",
    "matter-js": "^0.20.0",
    "mediabunny": "^1.66.2",
    "next": "16.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "19.3.1",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "fast-xml-parser": "^5.7.3",
    "googleapis": "^171.4.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
