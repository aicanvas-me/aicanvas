{
  "name": "aicanvas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "predev": "node scripts/check-deps.mjs",
    "dev": "node scripts/inject-premium.mjs && node scripts/generate-component-codes.mjs && node scripts/generate-registry.mjs && next dev -p 3001 --turbopack",
    "dev:webpack": "node scripts/inject-premium.mjs && node scripts/generate-component-codes.mjs && node scripts/generate-registry.mjs && next dev -p 3001 --webpack",
    "build": "node scripts/inject-premium.mjs && node scripts/generate-component-codes.mjs && node scripts/generate-registry.mjs && next build",
    "start": "next start",
    "publish-premium": "node scripts/publish-premium.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:andromeda": "node scripts/screenshot-andromeda.mjs",
    "speed": "npx unlighthouse@latest --site https://aicanvas.me",
    "validate:registry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-registry-json.ts",
    "gsc:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gsc-audit.ts",
    "gsc:submit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gsc-submit.ts",
    "gsc:keywords": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gsc-keywords.ts",
    "lint:prompts": "node scripts/lint-prompts.mjs",
    "andromeda:contrast": "node --import ./design-systems/andromeda/_tools/ts-resolve.mjs design-systems/andromeda/_tools/light-contrast.selfcheck.mjs"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.78.0",
    "@paddle/paddle-js": "^1.6.4",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@types/matter-js": "^0.20.2",
    "@types/three": "^0.183.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "lucide-react": "^1.7.0",
    "matter-js": "^0.20.0",
    "mediabunny": "^1.45.2",
    "next": "16.2.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-colorful": "^5.7.0",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "fast-xml-parser": "^5.7.3",
    "googleapis": "^171.4.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
